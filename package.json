{
  "name": "auto-line-reveal",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-web-types.mjs && vite build && tsc -p tsconfig.build.json && mkdir -p dist && cp src/style.css dist/style.css",
    "preview": "vite preview",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "main": "./dist/auto-line-reveal.cjs",
  "module": "./dist/auto-line-reveal.js",
  "types": "./dist/index.d.ts",
  "web-types": "./web-types.json",
  "customElements": "./custom-elements.json",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/auto-line-reveal.js",
      "require": "./dist/auto-line-reveal.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "web-types.json",
    "custom-elements.json"
  ],
  "style": "./dist/style.css",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.6.0",
    "terser": "^5.46.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1"
  }
}
